[wifi]
command=~/.config/i3blocks/scripts/wifi.sh
interval=5

[battery]
command=cat /sys/class/power_supply/BAT1/capacity
interval=30
label=BAT 

[volume]
command=pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5; exit}'
interval=once
signal=10
label=VOL 

[temp]
command=cat /sys/class/thermal/thermal_zone0/temp | awk '{printf "%.0f°C\n", $1/1000}'
interval=10
label=CPU 

[time]
command=date '+%a %d %b %I:%M %p '
interval=30
