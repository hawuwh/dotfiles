# general
set $mod Mod4
font pango:Hack 11

floating_modifier $mod
tiling_drag modifier titlebar

# startup
#exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- xsecurelock
exec --no-startup-id xfsettingsd
exec --no-startup-id feh --bg-fill ~/Pictures/wallpapers/wallpaper4.png

# programs
bindsym $mod+Return exec alacritty
bindsym $mod+d exec --no-startup-id dmenu_run -fn "Hack:size=12"

bindsym $mod+e workspace number 4, exec --no-startup-id thunar
bindsym $mod+t workspace number 1, exec --no-startup-id helium
bindsym $mod+m workspace number 10, exec --no-startup-id "alacritty --class termusic,termusic -e /home/how/.local/share/cargo/bin/termusic"
bindsym $mod+p workspace number 3, exec --no-startup-id sioyek
bindsym $mod+v workspace number 5, exec --no-startup-id virtualbox
bindsym $mod+o workspace number 2, exec --no-startup-id "alacritty --class todo,todo -e /home/how/.local/bin/todo-glow /home/how/Documents/todo.md"

# window controls
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+s layout toggle split
bindsym $mod+w layout tabbed

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# resize mode
bindsym $mod+r mode "resize"

mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

# i3
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# volume
bindsym XF86AudioRaiseVolume exec --no-startup-id sh -c 'pactl set-sink-volume @DEFAULT_SINK@ +5% && pkill -RTMIN+10 i3blocks'
bindsym XF86AudioLowerVolume exec --no-startup-id sh -c 'pactl set-sink-volume @DEFAULT_SINK@ -5% && pkill -RTMIN+10 i3blocks'
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +5% && pkill -RTMIN+11 i3blocks
bindsym XF86MonBrightnessDown exec brightnessctl set 5%- && pkill -RTMIN+11 i3blocks

# screenshots (https://gist.github.com/dianjuar/ee774561a8bc02b077989bc17424a19f)
# maim & xclip
bindsym Print exec --no-startup-id maim "/home/$USER/Pictures/Screenshots/$(date)"
bindsym $mod+Print exec --no-startup-id maim --window $(xdotool getactivewindow) "/home/$USER/Pictures/Screenshots/$(date)"
bindsym Shift+Print exec --no-startup-id maim --select "/home/$USER/Pictures/Screenshots/$(date)"

bindsym Ctrl+Print exec --no-startup-id maim | xclip -selection clipboard -t image/png
bindsym Ctrl+$mod+Print exec --no-startup-id maim --window $(xdotool getactivewindow) | xclip -selection clipboard -t image/png
bindsym Ctrl+Shift+Print exec --no-startup-id maim --select | xclip -selection clipboard -t image/png

# workspace assignments
assign [class="Helium"] $ws1
assign [class="sioyek"] $ws3
assign [class="VirtualBox Manager"] $ws5
assign [class="Thunar"] $ws4
assign [class="^termusic$"] $ws10

# floating windows
for_window [window_type="dialog"] floating enable
for_window [instance="^VirtualBox Machine$" class="^VirtualBox Machine$"] floating enable, resize set 720 450, move position center
for_window [class="^VirtualBox$" title=".* - Settings$"] floating enable, move position center
for_window [class="^VirtualBox$" title=".* - Preferences$"] floating enable, move position center
for_window [class="Nsxiv"] floating enable
for_window [class="^todo$"] floating enable, resize set 800 450, move position 1108 px 40 px 

# bar
bar {
        position top
        status_command i3blocks
        separator_symbol "::"
        tray_output none
}
