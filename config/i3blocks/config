[music]
command=~/.config/i3blocks/scripts/music.sh
interval=2

[volume]
command=~/.config/i3blocks/scripts/volume.sh
interval=once
signal=10

[wifi]
command=~/.config/i3blocks/scripts/wifi.sh
interval=5

[brightness]
command=~/.config/i3blocks/scripts/brightness.sh
interval=once
signal=11

[battery]
command=~/.config/i3blocks/scripts/battery.sh
interval=10

[time]
command=date '+%a, %b %d %I:%M %p '
interval=30
